<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DamagePercent_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c,&quot;Damaged&quot;),
DamagePercent__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Damage Percent is required</errorMessage>
</ValidationRule>
