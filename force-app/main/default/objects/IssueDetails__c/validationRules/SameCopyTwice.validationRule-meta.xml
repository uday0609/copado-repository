<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SameCopyTwice</fullName>
    <active>true</active>
    <errorConditionFormula>AND (
  ISPICKVAL (Status__c, &quot;Issue&quot;),
  ISPICKVAL (IssuingCopy__r.Status__c, &quot;Issued&quot;)
)</errorConditionFormula>
    <errorMessage>Same Copy Cannot Be Issued Twice</errorMessage>
</ValidationRule>
