<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IssueDateRequiredWhenIssued</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Issue&quot;),
  ISBLANK(IssueDate__c)
)</errorConditionFormula>
    <errorMessage>IssueDate Required When Status = Issue</errorMessage>
</ValidationRule>
