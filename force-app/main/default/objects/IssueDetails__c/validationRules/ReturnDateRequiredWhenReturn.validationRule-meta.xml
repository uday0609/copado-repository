<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ReturnDateRequiredWhenReturn</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Return&quot;),
  ISBLANK(ReturnDate__c)
)</errorConditionFormula>
    <errorMessage>ReturnDate Required When Status = Return</errorMessage>
</ValidationRule>
