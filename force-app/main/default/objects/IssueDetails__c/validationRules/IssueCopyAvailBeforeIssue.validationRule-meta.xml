<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IssueCopyAvailBeforeIssue</fullName>
    <active>true</active>
    <errorConditionFormula>AND (
  ISPICKVAL (Status__c, &quot;Issue&quot;),
  NOT (ISPICKVAL (IssuingCopy__r.Status__c, &quot;Available&quot;))
)</errorConditionFormula>
    <errorMessage>IssuingCopy Must Be Available Before Issue</errorMessage>
</ValidationRule>
