<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MembershipDateValidation</fullName>
    <active>true</active>
    <errorConditionFormula>MemberShipDate__c &gt; TODAY()</errorConditionFormula>
    <errorMessage>Membership Date Cannot Be Future</errorMessage>
</ValidationRule>
