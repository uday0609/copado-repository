<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IssueStatusCheckValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  IssueStatus__c = TRUE,
  NOT(Updated_By_Automation__c)
)</errorConditionFormula>
    <errorMessage>IssueStatus Cannot Be Checked Manually</errorMessage>
</ValidationRule>
