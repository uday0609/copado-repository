<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Date_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>Date__c &lt;&gt; TODAY()</errorConditionFormula>
    <errorMessage>Date cannot be of past or future</errorMessage>
</ValidationRule>
