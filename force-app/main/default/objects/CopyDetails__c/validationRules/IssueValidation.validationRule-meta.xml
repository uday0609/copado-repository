<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IssueValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Issued&quot;),
  OR(
    ISPICKVAL(PRIORVALUE(Status__c), &quot;Lost&quot;),
    ISPICKVAL(PRIORVALUE(Status__c), &quot;Damaged&quot;)
  )
)</errorConditionFormula>
    <errorMessage>Lost/Damaged Copy Cannot Be Issued Again</errorMessage>
</ValidationRule>
