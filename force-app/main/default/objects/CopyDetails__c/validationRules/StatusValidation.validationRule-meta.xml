<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>StatusValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(PRIORVALUE(Status__c), &quot;Lost&quot;),
  ISPICKVAL(Status__c, &quot;Available&quot;)
)</errorConditionFormula>
    <errorMessage>Status Cannot Change from Lost to Available Directly</errorMessage>
</ValidationRule>
