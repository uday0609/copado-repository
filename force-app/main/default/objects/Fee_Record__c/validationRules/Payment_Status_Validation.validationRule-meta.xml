<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Status_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    TEXT(Payment_Status__c) = &quot;Completed&quot;,
    PayAmount__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Payment Status cannot be “Completed” if amount = 0</errorMessage>
</ValidationRule>
