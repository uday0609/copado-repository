<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Date_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>PayDate__c &gt; TODAY()</errorConditionFormula>
    <errorMessage>Payment Date cannot be the future date</errorMessage>
</ValidationRule>
