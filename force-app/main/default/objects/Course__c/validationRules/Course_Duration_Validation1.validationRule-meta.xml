<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Course_Duration_Validation1</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    OR(
        ISPICKVAL(Type__c, &quot;Diploma&quot;),
        ISPICKVAL(Type__c, &quot;Internship&quot;)
    ),
    NOT(CONTAINS(LOWER(Duration__c), &quot;months&quot;))
)</errorConditionFormula>
    <errorMessage>The duration of internship and diploma should be in months</errorMessage>
</ValidationRule>
