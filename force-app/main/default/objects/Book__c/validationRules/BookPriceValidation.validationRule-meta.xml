<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BookPriceValidation</fullName>
    <active>true</active>
    <errorConditionFormula>OR (BookPrice__c &lt; 500, BookPrice__c &gt; 5000)</errorConditionFormula>
    <errorMessage>Book price should be between 500 to 5000</errorMessage>
</ValidationRule>
