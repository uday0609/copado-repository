<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BirthDate_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>BirthDate__c &gt; TODAY()</errorConditionFormula>
