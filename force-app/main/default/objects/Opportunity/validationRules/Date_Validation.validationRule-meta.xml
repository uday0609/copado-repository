<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Date_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(StageName , &apos;Closed Won&apos;),  CloseDate &lt; TODAY())</errorConditionFormula>
    <errorMessage>Closed Date cannot be past</errorMessage>
</ValidationRule>
