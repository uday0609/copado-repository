<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FeeDateValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
   ISNEW(),
   DateOfDeposit__c &gt; TODAY()
)</errorConditionFormula>
    <errorMessage>Fees date cannot be the the future date</errorMessage>
</ValidationRule>
