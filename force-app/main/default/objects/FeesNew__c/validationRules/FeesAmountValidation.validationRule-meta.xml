<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FeesAmountValidation</fullName>
    <active>true</active>
    <errorConditionFormula>Amount__c &gt;   Enrollment__r.Balance_Amount__c</errorConditionFormula>
