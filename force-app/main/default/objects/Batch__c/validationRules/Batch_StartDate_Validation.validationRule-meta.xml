<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Batch_StartDate_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>ISNEW() &amp;&amp; Start_Date__c &lt; TODAY()</errorConditionFormula>
    <errorMessage>The Start Date cannot be in the past</errorMessage>
</ValidationRule>
