<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FeesAmountValidation</fullName>
    <active>true</active>
    <errorConditionFormula>Fees__c &lt; 5000  &amp;&amp; Fees__c &gt; 50000</errorConditionFormula>
    <errorMessage>Fees should be greater than 5000</errorMessage>
</ValidationRule>
